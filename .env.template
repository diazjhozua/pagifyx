# Copy this file to .env and fill in the values. .env is gitignored.
#
# Any OpenAI-compatible Chat Completions endpoint works. To switch providers,
# change these three values only.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-model-name

# Optional: where generated brochures and downloaded assets are written.
# Relative paths resolve from the directory you run the app in.
# OUTPUT_DIR=output
